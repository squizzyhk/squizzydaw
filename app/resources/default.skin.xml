<?xml version="1.0" encoding="UTF-8"?>
<!-- Squizzy Studio default skin (original). The Main form lays out the window; its custom elements
     are the GUI panels (app/src/gui_panels.hpp), each painting itself with the active theme:
       MenuBar TransportBar Browser Arrange PanelTabs ClipEditor Mixer DeviceRack StatusBar
       HSplitter (resizes "bottom") VSplitter (resizes "browser")
     Named elements the app toggles: browser, browserSplit, bottom, bottomSplit, mixer, editor, devices. -->
<Skin name="default" format="1">
  <Defines>
    <define name="bg" value="#1C1D21"/>
    <define name="panel" value="#26282E"/>
  </Defines>
  <Forms>
    <Form name="Main" direction="column" background="$(bg)">
      <MenuBar name="menubar" height="28"/>
      <TransportBar name="transport" height="52"/>
      <View name="middle" direction="row" grow="1" shrink="1" minHeight="120">
        <Browser name="browser" width="250"/>
        <VSplitter name="browserSplit" width="4"/>
        <Arrange name="arrange" grow="1" shrink="1"/>
      </View>
      <HSplitter name="bottomSplit" height="4"/>
      <View name="bottom" direction="column" height="320">
        <PanelTabs name="tabs" height="28"/>
        <Mixer name="mixer" grow="1"/>
        <ClipEditor name="editor" grow="1"/>
        <DeviceRack name="devices" grow="1"/>
      </View>
      <StatusBar name="statusbar" height="24"/>
    </Form>
  </Forms>
</Skin>

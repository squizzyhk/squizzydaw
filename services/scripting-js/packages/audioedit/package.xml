      <Command category="Audio" name="Gain Down" title="Lower Clip Gain"/>
      <Command category="Audio" name="Reset Gain" title="Reset Clip Gain"/>
    </ScriptClass>
    <ScriptClass classID="{6FEFA626-095C-49E5-9C37-2E06D1C5F6EF}" category="Command" name="Audio Edit: Edge Fades"
                 sourceFile="fades.js" functionName="createFadeCommands">
      <Command category="Audio" name="Apply Fades" title="Apply Edge Fades"/>
      <Command category="Audio" name="Remove Fades" title="Remove Fades"/>
    </ScriptClass>
  </ClassFactory>
</ScriptPackage>

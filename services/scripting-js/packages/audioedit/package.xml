<?xml version="1.0" encoding="UTF-8"?>
<!-- Audio clip editing commands (Squizzy Studio bundled package). -->
<ScriptPackage id="squizzy.audioedit" name="Audio Edit" version="1.0.0" abi="1.0">
  <ClassFactory>
    <ScriptClass classID="{1B61330A-2A08-47AA-9F03-D498374A92A1}" category="Command" name="Audio Edit: Normalize Clips"
                 sourceFile="normalize.js" functionName="createNormalizeCommand">
      <Command category="Audio" name="Normalize" title="Normalize Clips"/>
    </ScriptClass>
    <ScriptClass classID="{2B3FCCFB-0CB7-4BB3-BF16-3ABA16855514}" category="Command" name="Audio Edit: Clip Gain"
                 sourceFile="gain.js" functionName="createGainCommands">

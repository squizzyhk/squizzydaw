# CTest third_party_notices: bin/THIRD_PARTY_NOTICES.txt exists and carries every vendored
# library's name and full license text (MIT/BSD require the notice with every binary copy).
# Usage: cmake -DSQ_ROOT=<repo> -DNOTICES=<bin>/THIRD_PARTY_NOTICES.txt -P test_notices.cmake
if(NOT EXISTS "${NOTICES}")
  message(FATAL_ERROR "missing ${NOTICES}")
endif()
file(READ "${NOTICES}" _all)
file(GLOB _dirs LIST_DIRECTORIES true RELATIVE "${SQ_ROOT}/third_party" "${SQ_ROOT}/third_party/*")
set(_n 0)
foreach(_d IN LISTS _dirs)
  file(GLOB _lic LIST_DIRECTORIES false "${SQ_ROOT}/third_party/${_d}/LICENSE*" "${SQ_ROOT}/third_party/${_d}/COPYING*")
  foreach(_f IN LISTS _lic)
    file(READ "${_f}" _body)
    string(FIND "${_all}" "${_body}" _at)
    if(_at EQUAL -1)
      message(FATAL_ERROR "THIRD_PARTY_NOTICES.txt lacks the license text of third_party/${_d} (${_f})")
    endif()
    math(EXPR _n "${_n} + 1")
  endforeach()
endforeach()
if(_n EQUAL 0)
  message(FATAL_ERROR "no third_party licenses found under ${SQ_ROOT}/third_party")
endif()
message(STATUS "notices: ${_n} license file(s) present")
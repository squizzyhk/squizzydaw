# Unit test for sq_component_enabled (SQ_ONLY / SQ_SKIP). cmake -DSQ_ROOT=<repo> -P this-file
include("${SQ_ROOT}/cmake/SqHelpers.cmake")
set(_fail 0)
macro(expect only skip id want)
  set(SQ_ONLY "${only}")
  set(SQ_SKIP "${skip}")
  set(SQ_SKIP_SERVICES "")
  sq_component_filter_init()
  sq_component_enabled("${id}" _got)
  if(NOT "${_got}" STREQUAL "${want}")
    message(SEND_ERROR "only='${only}' skip='${skip}' id=${id}: got ${_got}, want ${want}")
    set(_fail 1)
  endif()
endmacro()
expect("" "" "services/codec-wav" ON)
expect("engine/doc;services/codec-wav" "" "engine" ON)
expect("engine/doc;services/codec-wav" "" "engine/doc" ON)
expect("engine/doc;services/codec-wav" "" "engine/graph" OFF)
expect("engine/doc;services/codec-wav" "" "services/codec-wav" ON)
expect("engine/doc;services/codec-wav" "" "services/codec-flac" OFF)
expect("engine/doc;services/codec-wav" "" "formats" OFF)
expect("engine" "" "engine/graph" ON)
expect("engine/" "" "engine/graph" ON)
expect("engine/doc" "" "engine/docx" OFF)
expect("" "services/foo" "services/foo" OFF)
expect("" "services/foo" "services/foobar" ON)
expect("engine" "engine/graph" "engine/graph" OFF)
expect("engine" "engine/graph" "engine/doc" ON)
set(SQ_ONLY "")
set(SQ_SKIP "")
set(SQ_SKIP_SERVICES "legacy")
sq_component_filter_init()
sq_component_enabled("services/legacy" _got)
if(_got)
  message(SEND_ERROR "SQ_SKIP_SERVICES=legacy should skip services/legacy")
  set(_fail 1)
endif()
if(_fail)
  message(FATAL_ERROR "component filter: FAILED")
endif()
message(STATUS "component filter: PASS")

# Squizzy Studio CMake helpers. Agents: use these instead of raw add_library/add_executable
# so that output layout, warnings, ABI/version stamping and test registration stay uniform.
#
#   sq_add_service(NAME <name> SOURCES ... [VERSION x.y.z] [LIBS ...] [TEST_MODULE] [DESCRIPTION "..."])
#       -> bin/services/<name>.dll (MODULE library exporting exactly GetClassFactory + ModuleMain)
#          TEST_MODULE puts it in bin/testmodules/ instead (not auto-loaded by the app).
#   sq_add_library(NAME <name> [STATIC|SHARED|INTERFACE] SOURCES ... [LIBS ...] [INCLUDE_DIRS ...])
#       -> internal library (static by default) for engine/, ui/, formats/ ...
#   sq_add_tool(NAME <name> SOURCES ... [LIBS ...])      -> bin/<name>.exe
#   sq_add_test(NAME <name> SOURCES ... [LIBS ...] [ARGS ...] [DEPENDS ...] [LABELS ...])
#       -> bin/sqtest_<name>.exe, registered in CTest as <name>
#   sq_target_defaults(<target>)                          -> warnings + common defines

include_guard(GLOBAL)

function(sq_target_defaults target)
  get_target_property(_type ${target} TYPE)
  if(_type STREQUAL "INTERFACE_LIBRARY")
    return()
  endif()
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8 /Zc:__cplusplus /Zc:preprocessor /EHsc /MP)
    if(SQ_WARNINGS_AS_ERRORS)
      target_compile_options(${target} PRIVATE /WX)
    endif()
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wno-unused-parameter)
    if(SQ_WARNINGS_AS_ERRORS)
      target_compile_options(${target} PRIVATE -Werror)
    endif()
  endif()
  if(WIN32)
    target_compile_definitions(${target} PRIVATE UNICODE _UNICODE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
  endif()
  set_target_properties(${target} PROPERTIES
    C_VISIBILITY_PRESET hidden
    CXX_VISIBILITY_PRESET hidden
    VISIBILITY_INLINES_HIDDEN ON)
endfunction()

# Put every artifact kind of <target> into <dir>, for single- and multi-config generators.
function(sq_set_output_dir target dir)
  set_target_properties(${target} PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${dir}"
    LIBRARY_OUTPUT_DIRECTORY "${dir}")
  foreach(cfg IN ITEMS Debug Release RelWithDebInfo MinSizeRel)
    string(TOUPPER ${cfg} CFG)
    set_target_properties(${target} PROPERTIES
      RUNTIME_OUTPUT_DIRECTORY_${CFG} "${dir}"
      LIBRARY_OUTPUT_DIRECTORY_${CFG} "${dir}")
  endforeach()
endfunction()

# Windows VERSIONINFO resource carrying version + platform ABI stamp.
function(sq_stamp_version target name version description filetype)
  if(NOT WIN32)
    return()
  endif()
  string(REPLACE "." ";" _p "${version}")
  list(GET _p 0 SQRC_V1)
  list(GET _p 1 SQRC_V2)
  list(GET _p 2 SQRC_V3)
  set(SQRC_NAME "${name}")
  set(SQRC_DESC "${description}")
  set(SQRC_VERSION "${version}")
  set(SQRC_FILETYPE "${filetype}")
  set(_rc "${CMAKE_BINARY_DIR}/generated/rc/${target}.rc")
  configure_file("${SQ_ROOT}/cmake/module_version.rc.in" "${_rc}" @ONLY)
  target_sources(${target} PRIVATE "${_rc}")
endfunction()

function(sq_pack_version out version)
  string(REPLACE "." ";" _p "${version}")
  list(GET _p 0 _a)
  list(GET _p 1 _b)
  list(GET _p 2 _c)
  math(EXPR _v "(${_a} << 24) | (${_b} << 16) | ${_c}" OUTPUT_FORMAT HEXADECIMAL)
  set(${out} ${_v} PARENT_SCOPE)
endfunction()

function(sq_add_service)
  cmake_parse_arguments(A "TEST_MODULE" "NAME;VERSION;DESCRIPTION" "SOURCES;LIBS" ${ARGN})
  if(NOT A_NAME)
    message(FATAL_ERROR "sq_add_service: NAME required")
  endif()
  if(NOT A_VERSION)
    set(A_VERSION ${SQ_VERSION})
  endif()
  if(NOT A_DESCRIPTION)
    set(A_DESCRIPTION "Squizzy Studio service: ${A_NAME}")
  endif()
  set(tgt svc_${A_NAME})
  add_library(${tgt} MODULE ${A_SOURCES})
  sq_target_defaults(${tgt})
  target_link_libraries(${tgt} PRIVATE sq::sdk sq::platform ${A_LIBS})
  sq_pack_version(_packed ${A_VERSION})
  target_compile_definitions(${tgt} PRIVATE
    SQ_BUILDING_MODULE=1
    SQ_MODULE_VERSION=${_packed}
    SQ_MODULE_VERSION_STR="${A_VERSION}"
    SQ_MODULE_TARGET_NAME="${A_NAME}")
  if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    # STB_GNU_UNIQUE symbols (inline statics) would make glibc refuse to dlclose the module.
    target_compile_options(${tgt} PRIVATE -fno-gnu-unique)
  endif()
  set_target_properties(${tgt} PROPERTIES OUTPUT_NAME "${A_NAME}" PREFIX "")
  if(A_TEST_MODULE)
    sq_set_output_dir(${tgt} "${SQ_TEST_MODULES_DIR}")
  else()
    sq_set_output_dir(${tgt} "${SQ_SERVICES_DIR}")
    set_property(GLOBAL APPEND PROPERTY SQ_SERVICE_TARGETS ${tgt})
  endif()
  if(UNIX AND NOT APPLE)
    set_target_properties(${tgt} PROPERTIES BUILD_RPATH "$ORIGIN/..")
  elseif(APPLE)
    set_target_properties(${tgt} PROPERTIES BUILD_RPATH "@loader_path/..")
  endif()
  sq_stamp_version(${tgt} ${A_NAME} ${A_VERSION} "${A_DESCRIPTION}" "VFT_DLL")
endfunction()

function(sq_add_library)
  cmake_parse_arguments(A "STATIC;SHARED;INTERFACE" "NAME" "SOURCES;LIBS;PUBLIC_LIBS;INCLUDE_DIRS" ${ARGN})
  if(A_INTERFACE)
    add_library(${A_NAME} INTERFACE)
    target_include_directories(${A_NAME} INTERFACE ${A_INCLUDE_DIRS})
    target_link_libraries(${A_NAME} INTERFACE ${A_PUBLIC_LIBS} ${A_LIBS})
    return()
  endif()
  if(A_SHARED)
    add_library(${A_NAME} SHARED ${A_SOURCES})
    sq_set_output_dir(${A_NAME} "${SQ_BIN_DIR}")
  else()
    add_library(${A_NAME} STATIC ${A_SOURCES})
  endif()
  sq_target_defaults(${A_NAME})
  target_include_directories(${A_NAME} PUBLIC ${A_INCLUDE_DIRS})
  target_link_libraries(${A_NAME} PUBLIC sq::sdk sq::platform ${A_PUBLIC_LIBS} PRIVATE ${A_LIBS})
endfunction()

function(sq_add_tool)
  cmake_parse_arguments(A "" "NAME;VERSION" "SOURCES;LIBS" ${ARGN})
  if(NOT A_VERSION)
    set(A_VERSION ${SQ_VERSION})
  endif()
  add_executable(${A_NAME} ${A_SOURCES})
  sq_target_defaults(${A_NAME})
  target_link_libraries(${A_NAME} PRIVATE sq::sdk sq::platform ${A_LIBS})
  sq_set_output_dir(${A_NAME} "${SQ_BIN_DIR}")
  sq_stamp_version(${A_NAME} ${A_NAME} ${A_VERSION} "Squizzy Studio tool: ${A_NAME}" "VFT_APP")
endfunction()

function(sq_add_test)
  cmake_parse_arguments(A "" "NAME;TIMEOUT" "SOURCES;LIBS;ARGS;DEPENDS;LABELS" ${ARGN})
  if(NOT SQ_BUILD_TESTS)
    return()
  endif()
  if(NOT A_TIMEOUT)
    set(A_TIMEOUT 120)
  endif()
  set(tgt sqtest_${A_NAME})
  add_executable(${tgt} ${A_SOURCES})
  sq_target_defaults(${tgt})
  target_link_libraries(${tgt} PRIVATE sq::test sq::sdk sq::platform ${A_LIBS})
  sq_set_output_dir(${tgt} "${SQ_BIN_DIR}")
  if(A_DEPENDS)
    add_dependencies(${tgt} ${A_DEPENDS})
  endif()
  add_test(NAME ${A_NAME} COMMAND ${tgt} ${A_ARGS} WORKING_DIRECTORY "${SQ_BIN_DIR}")
  # SQ_SKIP("why") exits 77: CTest reports the test as Skipped, never as passed (CONTRACTS 10).
  set_tests_properties(${A_NAME} PROPERTIES TIMEOUT ${A_TIMEOUT} SKIP_RETURN_CODE 77)
  if(A_LABELS)
    set_tests_properties(${A_NAME} PROPERTIES LABELS "${A_LABELS}")
  endif()
endfunction()

# ---- component filter (SQ_ONLY / SQ_SKIP) ---------------------------------------------------
# Component ids are repo-relative dirs: "ui", "engine", "engine/<x>", "formats", "formats/<x>",
# "tools", "tools/<x>", "services/<x>", "third_party/<x>".
#   SQ_ONLY="engine/doc;services/codec-wav"  builds only those (+ core). Empty = everything.
#     Listing a parent ("engine") enables all its children; listing a child ("engine/doc")
#     makes the root enter engine/ but only engine/doc is added.
#   SQ_SKIP="services/foo"                    excludes ids (and their children); wins over SQ_ONLY.
#   SQ_SKIP_SERVICES="foo;bar"                legacy alias for SQ_SKIP=services/foo;services/bar.
macro(sq_component_filter_init)
  set(_sq_only_norm "")
  foreach(_e IN LISTS SQ_ONLY)
    string(STRIP "${_e}" _e)
    string(REGEX REPLACE "/+$" "" _e "${_e}")
    if(_e)
      list(APPEND _sq_only_norm "${_e}")
    endif()
  endforeach()
  set(_sq_skip_norm "")
  foreach(_e IN LISTS SQ_SKIP)
    string(STRIP "${_e}" _e)
    string(REGEX REPLACE "/+$" "" _e "${_e}")
    if(_e)
      list(APPEND _sq_skip_norm "${_e}")
    endif()
  endforeach()
  foreach(_e IN LISTS SQ_SKIP_SERVICES)
    if(_e)
      list(APPEND _sq_skip_norm "services/${_e}")
    endif()
  endforeach()
  set_property(GLOBAL PROPERTY SQ_ONLY_NORM "${_sq_only_norm}")
  set_property(GLOBAL PROPERTY SQ_SKIP_NORM "${_sq_skip_norm}")
  if(_sq_only_norm)
    message(STATUS "sq: SQ_ONLY = ${_sq_only_norm} (+ core)")
  endif()
  if(_sq_skip_norm)
    message(STATUS "sq: SQ_SKIP = ${_sq_skip_norm}")
  endif()
endmacro()

# sq_component_enabled(<id> <out-var>): ON if <id> passes SQ_ONLY / SQ_SKIP.
function(sq_component_enabled id out)
  get_property(_only GLOBAL PROPERTY SQ_ONLY_NORM)
  get_property(_skip GLOBAL PROPERTY SQ_SKIP_NORM)
  foreach(_s IN LISTS _skip)
    if(id STREQUAL _s OR id MATCHES "^${_s}/")
      set(${out} OFF PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(NOT _only)
    set(${out} ON PARENT_SCOPE)
    return()
  endif()
  foreach(_o IN LISTS _only)
    # exact, ancestor listed (engine -> engine/doc), or descendant listed (engine/doc -> engine)
    if(id STREQUAL _o OR id MATCHES "^${_o}/" OR _o MATCHES "^${id}/")
      set(${out} ON PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} OFF PARENT_SCOPE)
endfunction()

# sq_add_child_components(): for parent dirs (engine/, formats/, tools/). Adds every
# <this dir>/<child>/CMakeLists.txt in sorted order, honouring SQ_ONLY / SQ_SKIP.
function(sq_add_child_components)
  file(RELATIVE_PATH _parent "${SQ_ROOT}" "${CMAKE_CURRENT_SOURCE_DIR}")
  file(GLOB _children LIST_DIRECTORIES true RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/*")
  list(SORT _children)
  foreach(_c IN LISTS _children)
    if(IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/${_c}" AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${_c}/CMakeLists.txt")
      sq_component_enabled("${_parent}/${_c}" _on)
      if(_on)
        message(STATUS "sq: component ${_parent}/${_c}/")
        add_subdirectory(${_c})
      else()
        message(STATUS "sq: component ${_parent}/${_c}/ (filtered out)")
      endif()
    endif()
  endforeach()
endfunction()

# sq_require_components(<id>...): call at the top of a component's CMakeLists when it links
# targets of another component. Fails configure with a clear message if one is missing or
# filtered out (add it to SQ_ONLY, or remove it from SQ_SKIP).
function(sq_require_components)
  file(RELATIVE_PATH _self "${SQ_ROOT}" "${CMAKE_CURRENT_SOURCE_DIR}")
  foreach(_id IN LISTS ARGN)
    if(NOT EXISTS "${SQ_ROOT}/${_id}/CMakeLists.txt")
      message(FATAL_ERROR "sq: ${_self} requires component '${_id}', which does not exist yet")
    endif()
    sq_component_enabled("${_id}" _on)
    if(NOT _on)
      message(FATAL_ERROR "sq: ${_self} requires component '${_id}': add it to SQ_ONLY (or drop it from SQ_SKIP)")
    endif()
  endforeach()
endfunction()

+  const TrackView* x = named(v, "Delays");
+  const TrackView* f = named(v, "Band");
+  const TrackView* s = named(v, "Synth");
+  const TrackView* d = named(v, "Drums");
+  const TrackView* m = ofKind(v, SQ_TRACK_MASTER);
+  REQUIRE(b);
+  REQUIRE(x);
+  REQUIRE(f);
+  REQUIRE(s);
+  REQUIRE(d);

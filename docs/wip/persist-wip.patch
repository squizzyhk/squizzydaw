+  CHECK_EQ(ir.warnings, std::string());
+  CHECK_EQ(ir.tracks, 5);
+  CHECK_EQ(ir.devices, 6);
+  CHECK_EQ(ir.sends, 2);
+  CHECK_EQ(ir.automation, 7);

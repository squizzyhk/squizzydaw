+// '/' separators, no trailing separator (except a bare root).
+std::string slashed(std::string p) {
+  for (char& ch : p)
+    if (ch == '\\') ch = '/';
+  while (p.size() > 1 && p.back() == '/' && !(p.size() == 3 && p[1] == ':')) p.pop_back();
+  return p;
